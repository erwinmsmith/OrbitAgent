NODE_ENV=production

# Backend container listens inside Docker on 3000. The compose file publishes it
# to 127.0.0.1:3100 for the host Nginx reverse proxy.
HOST=0.0.0.0
PORT=3000

# MongoDB Atlas is recommended for production. If this is empty, the backend
# falls back to MONGODB_HOST / MONGODB_PORT / MONGODB_DATABASE.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_DATABASE=orbit_agent

# In docker-compose.aliyun.yml Redis is provided by the internal redis service.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_KEY_PREFIX=orbit:

DEEPSEEK_API_KEY=<your_deepseek_api_key>
DEEPSEEK_BASE_URL=https://api.deepseek.com

JWT_SECRET=<replace_with_a_long_random_secret>
JWT_REFRESH_SECRET=<replace_with_another_long_random_secret>

# Keep this as remote-zhipu when the production knowledge base was embedded
# with Zhipu embedding-3.
ORBIT_EMBEDDER=remote-zhipu
ZHIPU_API_KEY=<your_zhipu_api_key>
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_EMBED_MODEL=embedding-3
